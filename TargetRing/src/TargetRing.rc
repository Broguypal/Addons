#include <winver.h>

#define TARGETRING_VERSION      1,0,0,0
#define TARGETRING_VERSION_STR  "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TARGETRING_VERSION
PRODUCTVERSION  TARGETRING_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Broguypal"
            VALUE "FileDescription",  "TargetRing - target and subtarget ground ring for Windower"
            VALUE "FileVersion",      TARGETRING_VERSION_STR
            VALUE "InternalName",     "TargetRing"
            VALUE "OriginalFilename", "TargetRing.dll"
            VALUE "ProductName",      "TargetRing"
            VALUE "ProductVersion",   TARGETRING_VERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
